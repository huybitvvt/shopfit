# Keep this key on the server. Never add it to EXPO_PUBLIC_* variables.
# Supabase Session pooler URL (Connect -> Session pooler), with the DB password URL-encoded.
# Empty DATABASE_URL uses local SQLite for offline development/tests.
DATABASE_URL=
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_VISION_MODEL=gemini-2.5-flash
# 1K keeps detail. 512 is a faster/lower-detail option for Gemini 3.1 Flash Image.
GEMINI_IMAGE_SIZE=1K
# Disable dynamic thinking for the short Gemini 2.5 Flash inspection calls.
GEMINI_VISION_THINKING_BUDGET=0
# Left/back/right run together after the approved front; 1 restores sequential rendering.
TRYON_VIEW_CONCURRENCY=3
# Use 'front' for fastest 1-image try-on (~10-12s); use 'front,left,back,right' for full 4-angle generation.
TRYON_ANGLES=front
TRYON_DAILY_LIMIT=30
# Local request limits and cost estimates, not the provider's invoice. Errors still consume reservations.
AI_IMAGE_DAILY_LIMIT=120
AI_VISION_DAILY_LIMIT=300
AI_DAILY_BUDGET_USD=15
AI_IMAGE_ESTIMATE_USD=0.10
AI_VISION_ESTIMATE_USD=0.002
# Development accounts only. Disable before exposing the service publicly.
SEED_DEMO=true
DEMO_CUSTOMER_PASSWORD=Shopfit123!
DEMO_ADMIN_PASSWORD=ShopfitAdmin123!
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006

# Cloudfly S3 Object Storage
CLOUDFLY_ENDPOINT_URL=
CLOUDFLY_ACCESS_KEY=
CLOUDFLY_SECRET_KEY=
CLOUDFLY_BUCKET_NAME=shopfit
CLOUDFLY_REGION=us-east-1
CLOUDFLY_PUBLIC_URL=

# Email Delivery for OTP (Resend API is recommended on Render Free because outbound SMTP ports are blocked)
RESEND_API_KEY=
BREVO_API_KEY=

# Standard SMTP (Gmail, etc. - works on local or paid cloud instances)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
