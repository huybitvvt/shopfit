# Keep this key on the server. Never add it to EXPO_PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VISION_MODEL=gemini-2.5-flash
TRYON_DAILY_LIMIT=30
# Local request limits and cost estimates, not the provider's invoice. Errors still consume reservations.
AI_IMAGE_DAILY_LIMIT=120
AI_VISION_DAILY_LIMIT=300
AI_DAILY_BUDGET_USD=15
AI_IMAGE_ESTIMATE_USD=0.10
AI_VISION_ESTIMATE_USD=0.002
# Development accounts only. Disable before exposing the service publicly.
SEED_DEMO=true
DEMO_CUSTOMER_PASSWORD=Shopfit123!
DEMO_ADMIN_PASSWORD=ShopfitAdmin123!
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
