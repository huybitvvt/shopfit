{
  "expo": {
    "name": "ShopFit",
    "slug": "shopfit",
    "scheme": "shopfit",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/shopfit-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.shopfit.studio"
    },
    "android": {
      "package": "vn.shopfit.studio",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#344E40",
        "foregroundImage": "./assets/shopfit-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/shopfit-icon.png",
      "bundler": "metro",
      "name": "ShopFit Studio — Phòng Thử Đồ AI & Tư Vấn Size",
      "shortName": "ShopFit",
      "lang": "vi",
      "themeColor": "#344E40",
      "description": "Thời trang thiết kế tích hợp Phòng thử đồ ảo AI 4 góc & Tư vấn chọn size thông minh theo số đo cơ thể."
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "ShopFit cần chọn ảnh để bạn thử trang phục.",
          "cameraPermission": "ShopFit cần camera để chụp ảnh thử trang phục.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/shopfit-icon.png",
          "color": "#344E40"
        }
      ],
      "expo-build-properties"
    ]
  }
}
